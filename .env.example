# Copy to .env.local for local work; on Vercel set these under Project Settings > Environment Variables.
# Backend API base, including /api. Defaults to http://localhost:8080/api when unset.
REACT_APP_API_URL=https://your-backend.onrender.com/api
# Set to true when the backend requires the shared access key (shows the key screen on first load).
REACT_APP_REQUIRE_ACCESS_KEY=false
